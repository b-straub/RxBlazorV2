<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <!-- xunit.v3 test projects run as Microsoft.Testing.Platform executables (runner selected in global.json). -->
        <OutputType>Exe</OutputType>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <LangVersion>preview</LangVersion>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing.XUnit"/>
        <PackageReference Include="xunit.analyzers">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.XUnit"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing.XUnit"/>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.v3.assert">
            <Aliases>xunitv3</Aliases>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\RxBlazorV2CodeFix\RxBlazorV2CodeFix.csproj"/>
        <ProjectReference Include="..\RxBlazorV2Generator\RxBlazorV2Generator.csproj"/>
        <ProjectReference Include="..\RxBlazorV2\RxBlazorV2.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <!--
      SSOT: the analyzer/generator test harness must resolve the exact same package versions
      that Directory.Packages.props declares. Project the central @(PackageVersion) items into a
      generated constants file instead of duplicating version strings in test code.
      ';' is escaped as %3B so WriteLinesToFile does not treat it as an item separator.
    -->
    <Target Name="GeneratePackageVersionConstants" BeforeTargets="BeforeCompile;CoreCompile">
        <PropertyGroup>
            <!-- IntermediateOutputPath is only defined once the SDK targets are imported. -->
            <_PackageVersionsFile>$(IntermediateOutputPath)PackageVersions.g.cs</_PackageVersionsFile>
        </PropertyGroup>

        <ItemGroup>
            <_PackageVersionEntry Include="@(PackageVersion)">
                <Line>        { "%(Identity)", "%(PackageVersion.Version)" },</Line>
            </_PackageVersionEntry>
        </ItemGroup>

        <PropertyGroup>
            <_PackageVersionsContent>
<![CDATA[// <auto-generated />
#nullable enable
namespace RxBlazorV2.GeneratorTests.Helpers%3B

/// <summary>Central package versions projected from Directory.Packages.props at build time.</summary>
internal static class PackageVersions
{
    private static readonly System.Collections.Generic.Dictionary<string, string> Versions =
        new(System.StringComparer.OrdinalIgnoreCase)
        {
@(_PackageVersionEntry->'%(Line)', '%0A')
        }%3B

    /// <summary>Resolves the centrally managed version of <paramref name="packageId" />.</summary>
    public static string For(string packageId)
    {
        if (!Versions.TryGetValue(packageId, out var version))
        {
            throw new System.InvalidOperationException(
                $"Directory.Packages.props declares no PackageVersion for '{packageId}'.")%3B
        }

        return version%3B
    }
}
]]>
            </_PackageVersionsContent>
        </PropertyGroup>

        <MakeDir Directories="$(IntermediateOutputPath)" />
        <WriteLinesToFile File="$(_PackageVersionsFile)"
                          Lines="$(_PackageVersionsContent.Trim())"
                          Overwrite="true"
                          WriteOnlyWhenDifferent="true" />

        <ItemGroup>
            <Compile Include="$(_PackageVersionsFile)" />
            <FileWrites Include="$(_PackageVersionsFile)" />
        </ItemGroup>
    </Target>

</Project>
