@using RxBlazorV2.Model
@inherits StatusModelComponent

@* Error Icon (separate from messages) *@
@if (ShowErrorIcon && ErrorMessages.Count > 0)
{
    <MudFab Class=@(ShowMessageIcon && NonErrorMessages.Count > 0 ? "mr-2" : "") StartIcon="@ErrorIcon" Size="Size.Small" Color="Color.Error" Label="@ErrorMessages.Count.ToString()" OnClick="ShowErrorSnackbarOnClick" />
}

@* Message Icon (Info, Success, Warning - separate from errors) *@
@if (ShowMessageIcon && NonErrorMessages.Count > 0)
{
    <MudFab StartIcon="@GetMessageIcon()" Size="Size.Small" Color="@GetMessageIconColor()" Label="@NonErrorMessages.Count.ToString()" OnClick="ShowMessageSnackbarOnClick" />
}

@code
{
    #region Channel Settings

    /// <summary>
    /// The status channel this display serves. Several displays can share one status model, each serving
    /// its own channel - e.g. errors and system notifications on the default channel, database
    /// notifications on a custom one. Command errors are always published to
    /// <see cref="StatusMessage.DefaultChannel"/>. Default: <see cref="StatusMessage.DefaultChannel"/>.
    /// </summary>
    [Parameter]
    public string Channel { get; set; } = StatusMessage.DefaultChannel;

    #endregion

    #region Error Settings (StatusSeverity.Error only)

    /// <summary>
    /// How errors are displayed. Default: SNACKBAR_AND_ICON.
    /// In SNACKBAR + Aggregate mode: errors accumulate while snackbar is visible,
    /// dismissed when snackbar closes.
    /// </summary>
    [Parameter]
    public StatusDisplayMode ErrorDisplayMode { get; set; } = StatusDisplayMode.SNACKBAR_AND_ICON;

    /// <summary>
    /// How errors are accumulated. Default: Aggregate.
    /// </summary>
    [Parameter]
    public StatusMessageMode ErrorMessageMode { get; set; } = StatusMessageMode.Aggregate;

    /// <summary>
    /// Whether to show the source (e.g., command name) in error messages. Default: true.
    /// </summary>
    [Parameter]
    public bool ShowErrorSource { get; set; } = true;

    #endregion

    #region Message Settings (Info, Success, Warning)

    /// <summary>
    /// How non-error messages are displayed. Default: SNACKBAR.
    /// In SNACKBAR + Aggregate mode: messages accumulate while snackbar is visible,
    /// dismissed when snackbar closes.
    /// </summary>
    [Parameter]
    public StatusDisplayMode MessageDisplayMode { get; set; } = StatusDisplayMode.SNACKBAR;

    /// <summary>
    /// How non-error messages are accumulated. Default: Aggregate.
    /// </summary>
    [Parameter]
    public StatusMessageMode MessageMessageMode { get; set; } = StatusMessageMode.Aggregate;

    /// <summary>
    /// Whether to show the source in non-error messages. Default: true.
    /// </summary>
    [Parameter]
    public bool ShowMessageSource { get; set; } = true;

    /// <summary>
    /// When true, groups non-error messages by severity (Warning first, then Success, then Info)
    /// with newest on top within each group.
    /// When false, shows all messages strictly by time with newest on top.
    /// Default: true.
    /// </summary>
    [Parameter]
    public bool GroupMessagesBySeverity { get; set; } = true;

    #endregion

    #region Icon Settings

    /// <summary>
    /// Icon of the error badge, error snackbars and error alerts. Default: Material Filled Error.
    /// </summary>
    [Parameter]
    public string ErrorIcon { get; set; } = Icons.Material.Filled.Error;

    /// <summary>
    /// Icon of warning messages; also the message badge icon while a warning is present.
    /// Default: Material Filled Warning.
    /// </summary>
    [Parameter]
    public string WarningIcon { get; set; } = Icons.Material.Filled.Warning;

    /// <summary>
    /// Icon of success messages; also the message badge icon while the most severe message is a success.
    /// Default: Material Filled CheckCircle.
    /// </summary>
    [Parameter]
    public string SuccessIcon { get; set; } = Icons.Material.Filled.CheckCircle;

    /// <summary>
    /// Icon of info messages; also the message badge icon while only info messages are present.
    /// Default: Material Filled Info.
    /// </summary>
    [Parameter]
    public string InfoIcon { get; set; } = Icons.Material.Filled.Info;

    #endregion

    #region Queue Settings

    /// <summary>
    /// How long a queued message of this display's channel waits before it is displayed. Queued messages
    /// are added through the model's QueueInfo / QueueSuccess methods; a message of the same channel
    /// arriving inside the window - or a clear covering its non-error messages - drops the queued one
    /// before it is ever shown.
    /// Default: 1 second.
    /// </summary>
    [Parameter]
    public TimeSpan QueueWindow { get; set; } = TimeSpan.FromSeconds(1);

    #endregion

    #region Snackbar Settings

    /// <summary>
    /// Position of the snackbar. Default: TopEnd.
    /// The MudBlazor snackbar configuration is global, so all displays share the position that was set last.
    /// </summary>
    [Parameter]
    public string SnackbarPositionClass { get; set; } = Defaults.Classes.Position.TopEnd;

    /// <summary>
    /// Short visibility of snackbar. Default: false.
    /// The MudBlazor snackbar configuration is global, so this applies to all displays.
    /// </summary>
    [Parameter]
    public bool ShortVisibility { get; set; }

    #endregion

    /// <summary>
    /// The MudBlazor snackbar service used to show error and message snackbars.
    /// </summary>
    [Inject]
    public required ISnackbar Snackbar { get; init; }

    private Snackbar? _currentErrorSnackbar;
    private Snackbar? _currentMessageSnackbar;

    // True while the current snackbar was opened from the icon (requires interaction, offers dismissal)
    private bool _isErrorSnackbarInteractive;
    private bool _isMessageSnackbarInteractive;

    // Prevent OnClose from dismissing messages during programmatic removal
    private bool _isUpdatingErrorSnackbar;
    private bool _isUpdatingMessageSnackbar;

    // Track previous state to detect changes (count + last message ID for Single mode)
    private int _previousErrorCount;
    private int _previousMessageCount;
    private Guid? _previousLastErrorId;
    private Guid? _previousLastMessageId;

    // Computed properties for filtering - only messages of this display's channel
    private List<StatusMessage> ErrorMessages => [.. Model.Messages.Where(m => m.Channel == Channel && m.Severity == StatusSeverity.Error)];
    private List<StatusMessage> NonErrorMessages => [.. Model.Messages.Where(m => m.Channel == Channel && m.Severity != StatusSeverity.Error)];

    // Display mode helpers
    private bool ShowErrorIcon => ErrorDisplayMode is StatusDisplayMode.ICON or StatusDisplayMode.SNACKBAR_AND_ICON;
    private bool ShowErrorSnackbar => ErrorDisplayMode is StatusDisplayMode.SNACKBAR or StatusDisplayMode.SNACKBAR_AND_ICON;
    private bool ShowMessageIcon => MessageDisplayMode is StatusDisplayMode.ICON or StatusDisplayMode.SNACKBAR_AND_ICON;
    private bool ShowMessageSnackbar => MessageDisplayMode is StatusDisplayMode.SNACKBAR or StatusDisplayMode.SNACKBAR_AND_ICON;

    // Track if snackbar is auto-aggregating (Aggregate + SNACKBAR without icon)
    private bool IsErrorAutoAggregate => ErrorMessageMode is StatusMessageMode.Aggregate && ErrorDisplayMode is StatusDisplayMode.SNACKBAR;
    private bool IsMessageAutoAggregate => MessageMessageMode is StatusMessageMode.Aggregate && MessageDisplayMode is StatusDisplayMode.SNACKBAR;

    /// <summary>
    /// Applies the snackbar configuration and syncs the display parameters to the settings of the
    /// display's channel.
    /// </summary>
    protected override void OnParametersSet()
    {
        Snackbar.Configuration.PositionClass = SnackbarPositionClass;

        if (ShortVisibility)
        {
            Snackbar.Configuration.VisibleStateDuration = 2000;
        }

        // Sync parameters to the channel's modes
        var settings = Model.GetChannelSettings(Channel);
        settings.ErrorMessageMode = ErrorMessageMode;
        settings.MessageMessageMode = MessageMessageMode;
        settings.QueueWindow = QueueWindow;

        base.OnParametersSet();
    }

    /// <summary>
    /// Updates the error and message snackbars whenever the messages of the display's channel change.
    /// </summary>
    protected override void OnMessagesChanged()
    {
        var errors = ErrorMessages;
        var messages = NonErrorMessages;
        var lastErrorId = errors.LastOrDefault()?.Id;
        var lastMessageId = messages.LastOrDefault()?.Id;

        // Update error snackbar if errors changed (count or content in Single mode).
        // An open interactive snackbar is refreshed in place, whatever the display mode.
        var errorsChanged = errors.Count != _previousErrorCount || lastErrorId != _previousLastErrorId;
        if ((ShowErrorSnackbar || _isErrorSnackbarInteractive) && errorsChanged)
        {
            if (errors.Count > 0)
            {
                DisplayErrorSnackbar(_isErrorSnackbarInteractive);
            }
            else
            {
                RemoveErrorSnackbar();
            }
        }

        // Update message snackbar if messages changed (count or content in Single mode)
        var messagesChanged = messages.Count != _previousMessageCount || lastMessageId != _previousLastMessageId;
        if ((ShowMessageSnackbar || _isMessageSnackbarInteractive) && messagesChanged)
        {
            if (messages.Count > 0)
            {
                DisplayMessageSnackbar(_isMessageSnackbarInteractive);
            }
            else
            {
                RemoveMessageSnackbar();
            }
        }

        _previousErrorCount = errors.Count;
        _previousMessageCount = messages.Count;
        _previousLastErrorId = lastErrorId;
        _previousLastMessageId = lastMessageId;
    }

    private void ShowErrorSnackbarOnClick()
    {
        DisplayErrorSnackbar(fromIconClick: true);
    }

    private void ShowMessageSnackbarOnClick()
    {
        DisplayMessageSnackbar(fromIconClick: true);
    }

    private void RemoveErrorSnackbar()
    {
        if (_currentErrorSnackbar is not null)
        {
            _isUpdatingErrorSnackbar = true;
            Snackbar.Remove(_currentErrorSnackbar);
            _currentErrorSnackbar = null;
            _isUpdatingErrorSnackbar = false;
        }
        _isErrorSnackbarInteractive = false;
    }

    private void RemoveMessageSnackbar()
    {
        if (_currentMessageSnackbar is not null)
        {
            _isUpdatingMessageSnackbar = true;
            Snackbar.Remove(_currentMessageSnackbar);
            _currentMessageSnackbar = null;
            _isUpdatingMessageSnackbar = false;
        }
        _isMessageSnackbarInteractive = false;
    }

    private void DisplayErrorSnackbar(bool fromIconClick = false)
    {
        RemoveErrorSnackbar();

        var errors = ErrorMessages;
        if (errors.Count == 0)
        {
            return;
        }

        // Use aggregated display when: from icon click OR multiple errors
        var useAggregated = fromIconClick || errors.Count > 1;

        if (useAggregated)
        {
            // Aggregated errors - use theme-aware background with filled alerts inside
            var parameters = new Dictionary<string, object>
            {
                { "Messages", errors },
                { "IconSelector", (Func<StatusSeverity, string>)GetSeverityIcon }
            };
            if (fromIconClick)
            {
                parameters.Add("OnClear", EventCallback.Factory.Create(this, DismissErrors));
                parameters.Add("OnDismiss", EventCallback.Factory.Create<StatusMessage>(this, DismissMessage));
            }

            _currentErrorSnackbar = Snackbar.Add<AggregatedMessagesContent>(
                parameters,
                Severity.Normal,
                opts =>
                {
                    opts.SnackbarVariant = Variant.Text;
                    if (fromIconClick)
                    {
                        opts.RequireInteraction = true;
                    }
                });
        }
        else
        {
            // Single error - use normal plain snackbar
            var error = errors[0];
            var text = error.Source is not null && ShowErrorSource ? $"{error.Message} ({error.Source})" : error.Message;
            _currentErrorSnackbar = Snackbar.Add(text, Severity.Error, opts => opts.Icon = ErrorIcon);
        }

        if (_currentErrorSnackbar is not null)
        {
            _isErrorSnackbarInteractive = fromIconClick;
            _currentErrorSnackbar.OnClose += OnErrorSnackbarClosed;
        }
    }

    private void DisplayMessageSnackbar(bool fromIconClick = false)
    {
        RemoveMessageSnackbar();

        var messages = NonErrorMessages;
        if (messages.Count == 0)
        {
            return;
        }

        // Use aggregated display when: from icon click OR multiple messages
        var useAggregated = fromIconClick || messages.Count > 1;

        if (useAggregated)
        {
            // Aggregated messages - use theme-aware background with filled alerts inside
            var parameters = new Dictionary<string, object>
            {
                { "Messages", messages },
                { "GroupBySeverity", GroupMessagesBySeverity },
                { "IconSelector", (Func<StatusSeverity, string>)GetSeverityIcon }
            };
            if (fromIconClick)
            {
                parameters.Add("OnClear", EventCallback.Factory.Create(this, DismissNonErrors));
                parameters.Add("OnDismiss", EventCallback.Factory.Create<StatusMessage>(this, DismissMessage));
            }

            _currentMessageSnackbar = Snackbar.Add<AggregatedMessagesContent>(
                parameters,
                Severity.Normal,
                opts =>
                {
                    opts.SnackbarVariant = Variant.Text;
                    if (fromIconClick)
                    {
                        opts.RequireInteraction = true;
                    }
                });
        }
        else
        {
            // Single message - use normal plain snackbar
            var msg = messages[0];
            var text = msg.Source is not null && ShowMessageSource ? $"{msg.Message} ({msg.Source})" : msg.Message;
            _currentMessageSnackbar = Snackbar.Add(text, ToMudSeverity(msg.Severity), opts => opts.Icon = GetSeverityIcon(msg.Severity));
        }

        if (_currentMessageSnackbar is not null)
        {
            _isMessageSnackbarInteractive = fromIconClick;
            _currentMessageSnackbar.OnClose += OnMessageSnackbarClosed;
        }
    }

    private void DismissErrors()
    {
        Model.DismissErrorMessages(Channel);
    }

    private void DismissNonErrors()
    {
        Model.DismissNonErrorMessages(Channel);
    }

    private void DismissMessage(StatusMessage message)
    {
        Model.DismissMessages([message]);
    }

    private void OnErrorSnackbarClosed(Snackbar snackbar)
    {
        // Don't dismiss messages if we're updating to show new aggregated content
        if (_isUpdatingErrorSnackbar)
        {
            return;
        }

        var wasInteractive = _isErrorSnackbarInteractive;
        _currentErrorSnackbar = null;
        _isErrorSnackbarInteractive = false;

        // In auto-aggregate mode, the messages are gone once the snackbar closes (timeout or dismissal)
        if (IsErrorAutoAggregate && !wasInteractive)
        {
            DismissErrors();
        }
    }

    private void OnMessageSnackbarClosed(Snackbar snackbar)
    {
        // Don't dismiss messages if we're updating to show new aggregated content
        if (_isUpdatingMessageSnackbar)
        {
            return;
        }

        var wasInteractive = _isMessageSnackbarInteractive;
        _currentMessageSnackbar = null;
        _isMessageSnackbarInteractive = false;

        // In auto-aggregate mode, the messages are gone once the snackbar closes (timeout or dismissal)
        if (IsMessageAutoAggregate && !wasInteractive)
        {
            DismissNonErrors();
        }
    }

    private Color GetMessageIconColor()
    {
        if (NonErrorMessages.Any(m => m.Severity == StatusSeverity.Warning))
        {
            return Color.Warning;
        }
        if (NonErrorMessages.Any(m => m.Severity == StatusSeverity.Success))
        {
            return Color.Success;
        }
        return Color.Info;
    }

    private string GetMessageIcon()
    {
        if (NonErrorMessages.Any(m => m.Severity == StatusSeverity.Warning))
        {
            return WarningIcon;
        }
        if (NonErrorMessages.Any(m => m.Severity == StatusSeverity.Success))
        {
            return SuccessIcon;
        }
        return InfoIcon;
    }

    private string GetSeverityIcon(StatusSeverity severity) => severity switch
    {
        StatusSeverity.Error => ErrorIcon,
        StatusSeverity.Warning => WarningIcon,
        StatusSeverity.Success => SuccessIcon,
        StatusSeverity.Info => InfoIcon,
        _ => throw new ArgumentOutOfRangeException(nameof(severity), severity, null)
    };

    private static Severity ToMudSeverity(StatusSeverity severity) => severity switch
    {
        StatusSeverity.Error => Severity.Error,
        StatusSeverity.Warning => Severity.Warning,
        StatusSeverity.Success => Severity.Success,
        _ => Severity.Info
    };
}
