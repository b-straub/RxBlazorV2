<Project>
  <ItemGroup>
    <!-- RxBlazorV2 internal NuGet packages (Release-only references) -->
    <PackageVersion Include="RxBlazorV2" Version="$(RxBlazorV2Version)" />
    <PackageVersion Include="RxBlazorV2.MudBlazor" Version="$(RxBlazorV2Version)" />

    <!-- Reactive / R3 -->
    <PackageVersion Include="R3" Version="1.3.1" />
    <PackageVersion Include="ObservableCollections.R3" Version="3.3.4" />

    <!-- ASP.NET Core / Blazor -->
    <PackageVersion Include="Microsoft.AspNetCore.Components" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" />

    <!-- Microsoft.Extensions -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />

    <!-- Roslyn / Source Generator tooling -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />

    <!-- Reference assemblies resolved by the generator/analyzer test harness (see TestShared) -->
    <PackageVersion Include="Microsoft.NETCore.App.Ref" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Net.Compilers.Toolset" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />

    <!-- Source generator / analyzer / code fix testing -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing.XUnit" Version="1.1.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.XUnit" Version="1.1.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing.XUnit" Version="1.1.2" />

    <!-- Source linking / packaging -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />

    <!-- Compile-time helpers -->
    <PackageVersion Include="Nullable" Version="1.3.1" />
    <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageVersion Include="System.Composition" Version="10.0.12" />
    <PackageVersion Include="cmdwtf.BuildTimestampGenerator" Version="1.1.0" />

    <!-- UI -->
    <PackageVersion Include="MudBlazor" Version="9.9.0" />

    <!-- Test platform -->
    <PackageVersion Include="bunit" Version="2.10.3" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />

    <!-- xUnit v3 -->
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="xunit.v3.assert" Version="4.0.0" />
    <PackageVersion Include="xunit.analyzers" Version="2.0.0" />
    <PackageVersion Include="Xunit.DependencyInjection" Version="12.0.1" />
  </ItemGroup>
</Project>
